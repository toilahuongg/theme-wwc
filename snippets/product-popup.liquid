{% comment %}
  Renders a product popup modal with enhanced customization options

  Accepts:
  - block: {Object} Block object containing popup settings
  - section_id: {String} Section ID for unique identifiers
  - button_text: {String} Custom button text (optional)
  - button_style: {String} Button style class (optional)
  - button_icon: {String} Icon name to display (optional)
  - show_icon: {Boolean} Whether to show icon (default: false)
  - icon_position: {String} Icon position 'left' or 'right' (default: 'left')

  Usage:
  {% render 'product-popup', block: block, section_id: section.id %}
  {% render 'product-popup', block: block, section_id: section.id, button_text: 'Custom Text' %}
  {% render 'product-popup', block: block, section_id: section.id, button_style: 'button button--primary', show_icon: true, icon_position: 'right' %}
{% endcomment %}

{%- liquid
  assign button_text = button_text | default: block.settings.text | default: block.settings.page.title | escape
  assign button_style = button_style | default: block.settings.button_style | default: 'product-popup-modal__button default'
  assign button_size = block.settings.button_size | default: ''
  assign show_icon = show_icon | default: block.settings.show_icon | default: false
  assign icon_position = icon_position | default: block.settings.icon_position | default: 'left'
  assign icon_name = button_icon | default: block.settings.button_icon | default: 'arrow'
  assign icon_only = block.settings.icon_only | default: false

  if button_size != ''
    assign button_style = button_style | append: ' ' | append: button_size
  endif

  if icon_only
    assign button_style = button_style | append: ' button--icon-only'
  endif

  assign modal_size = block.settings.modal_size | default: 'medium'
  assign show_close_button = block.settings.show_close_button | default: true
  assign close_on_backdrop_click = block.settings.close_on_backdrop_click | default: true
  assign close_on_escape = block.settings.close_on_escape | default: true
  assign content_alignment = block.settings.content_alignment | default: 'left'
  assign show_title = block.settings.show_title | default: true
  assign title_size = block.settings.title_size | default: 'h2'
  assign modal_animation = block.settings.modal_animation | default: 'fade'
  assign animation_duration = block.settings.animation_duration | default: 300
  assign custom_css_class = block.settings.custom_css_class | default: ''
  assign custom_liquid = block.settings.custom_liquid | default: ''
-%}

<modal-opener
  class="product-popup-modal__opener quick-add-hidden"
  data-modal="#PopupModal-{{ block.id }}"
  {{ block.shopify_attributes }}
>
  <button
    id="ProductPopup-{{ block.id }}"
    class="{{ button_style }}"
    type="button"
    aria-haspopup="dialog"
    {% if show_icon %}
      data-icon-position="{{ icon_position }}"
    {% endif %}
  >
    {%- if show_icon and icon_position == 'left' -%}
      <span class="button__icon button__icon--left">
        {%- case icon_name -%}
          {%- when 'arrow' -%}
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          {%- when 'plus' -%}
            {{- 'icon-plus.svg' | inline_asset_content -}}
          {%- when 'info' -%}
            {{- 'icon-info.svg' | inline_asset_content -}}
          {%- when 'question' -%}
            {{- 'icon-question-mark.svg' | inline_asset_content -}}
          {%- when 'chat' -%}
            {{- 'icon-chat-bubble.svg' | inline_asset_content -}}
          {%- when 'star' -%}
            {{- 'icon-star.svg' | inline_asset_content -}}
          {%- when 'heart' -%}
            {{- 'icon-heart.svg' | inline_asset_content -}}
          {%- when 'truck' -%}
            {{- 'icon-truck.svg' | inline_asset_content -}}
          {%- when 'return' -%}
            {{- 'icon-return.svg' | inline_asset_content -}}
          {%- when 'lock' -%}
            {{- 'icon-lock.svg' | inline_asset_content -}}
          {%- when 'size_rule' -%}
            {{- 'icon-ruler.svg' | inline_asset_content -}}
          {%- else -%}
            {{- 'icon-arrow.svg' | inline_asset_content -}}
        {%- endcase -%}
      </span>
    {%- endif -%}

    {%- unless icon_only -%}
      <span class="button__text">{{ button_text }}</span>
    {%- endunless -%}

    {%- if show_icon and icon_position == 'right' -%}
      <span class="button__icon button__icon--right">
        {%- case icon_name -%}
          {%- when 'arrow' -%}
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          {%- when 'plus' -%}
            {{- 'icon-plus.svg' | inline_asset_content -}}
          {%- when 'info' -%}
            {{- 'icon-info.svg' | inline_asset_content -}}
          {%- when 'question' -%}
            {{- 'icon-question-mark.svg' | inline_asset_content -}}
          {%- when 'chat' -%}
            {{- 'icon-chat-bubble.svg' | inline_asset_content -}}
          {%- when 'star' -%}
            {{- 'icon-star.svg' | inline_asset_content -}}
          {%- when 'heart' -%}
            {{- 'icon-heart.svg' | inline_asset_content -}}
          {%- when 'truck' -%}
            {{- 'icon-truck.svg' | inline_asset_content -}}
          {%- when 'return' -%}
            {{- 'icon-return.svg' | inline_asset_content -}}
          {%- when 'lock' -%}
            {{- 'icon-lock.svg' | inline_asset_content -}}
          {%- when 'size_rule' -%}
            {{- 'icon-ruler.svg' | inline_asset_content -}}
          {%- else -%}
            {{- 'icon-arrow.svg' | inline_asset_content -}}
        {%- endcase -%}
      </span>
    {%- endif -%}
  </button>
</modal-opener>

<modal-dialog
  id="PopupModal-{{ block.id }}"
  class="product-popup-modal product-popup-modal--{{ modal_size }}{% if custom_css_class != blank %} {{ custom_css_class }}{% endif %}"
  data-animation="{{ modal_animation }}"
  data-duration="{{ animation_duration }}"
  data-close-on-backdrop="{{ close_on_backdrop_click }}"
  data-close-on-escape="{{ close_on_escape }}"
  {{ block.shopify_attributes }}
>
  <div
    role="dialog"
    aria-label="{{ button_text }}"
    aria-modal="true"
    class="product-popup-modal__content product-popup-modal__content--{{ content_alignment }}"
    tabindex="-1"
  >
    {%- if show_close_button -%}
      <button
        id="ModalClose-{{ block.id }}"
        type="button"
        class="product-popup-modal__toggle"
        aria-label="{{ 'accessibility.close' | t }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
    {%- endif -%}
    <div class="product-popup-modal__content-info">
      {%- if show_title and block.settings.page.title != blank -%}
        <{{ title_size }} class="product-popup-modal__title">{{ block.settings.page.title | escape }}</{{ title_size }}>
      {%- endif -%}
      {%- if block.settings.page.content != blank -%}
        {{ block.settings.page.content }}
      {%- elsif block.settings.image != blank -%}
        <div class="product-popup-modal__image">
          <img
            srcset="
              {%- if block.settings.image.width >= 375 -%}{{ block.settings.image | image_url: width: 375 }} 375w,{%- endif -%}
              {%- if block.settings.image.width >= 550 -%}{{ block.settings.image | image_url: width: 550 }} 550w,{%- endif -%}
              {%- if block.settings.image.width >= 750 -%}{{ block.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
              {%- if block.settings.image.width >= 1100 -%}{{ block.settings.image | image_url: width: 1100 }} 1100w,{%- endif -%}
              {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
              {%- if block.settings.image.width >= 1780 -%}{{ block.settings.image | image_url: width: 1780 }} 1780w,{%- endif -%}
              {%- if block.settings.image.width >= 2000 -%}{{ block.settings.image | image_url: width: 2000 }} 2000w,{%- endif -%}
              {%- if block.settings.image.width >= 3000 -%}{{ block.settings.image | image_url: width: 3000 }} 3000w,{%- endif -%}
              {%- if block.settings.image.width >= 3840 -%}{{ block.settings.image | image_url: width: 3840 }} 3840w,{%- endif -%}
              {{ block.settings.image | image_url }} {{ block.settings.image.width }}w
            "
            sizes="100vw"
            src="{{ block.settings.image | image_url: width: 750 }}"
            loading="lazy"
            alt="{{ block.settings.image.alt | escape }}"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="product-popup-modal__image-img"
          >
        </div>
      {%- endif -%}
      {%- if custom_liquid != blank -%}
        <div class="product-popup-modal__custom-liquid">
          {{ custom_liquid }}
        </div>
      {%- endif -%}
    </div>
  </div>
</modal-dialog>

