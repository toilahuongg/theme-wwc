  # Function to get flag for country code
  assign current_country_code = localization.country.iso_code
  assign current_flag = '🏳️'
  for code in country_codes
    if code == current_country_code
      assign flag_index = forloop.index0
      assign current_flag = country_flags[flag_index]
      break
