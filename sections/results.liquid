{{ 'section-results.css' | asset_url | stylesheet_tag }}
{{ 'component-rte.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {% if section.settings.color_scheme == 'custom' %}
    .color-scheme-{{ section.id }}.color-custom {
      --color-background: {{ section.settings.custom_bg_color.red }}, {{ section.settings.custom_bg_color.green }}, {{ section.settings.custom_bg_color.blue }};
      --gradient-background: {{ section.settings.custom_bg_color }};
      --color-foreground: {{ section.settings.custom_text_color.red }}, {{ section.settings.custom_text_color.green }}, {{ section.settings.custom_text_color.blue }};
      --accent-color: {{ section.settings.custom_accent_color.red }}, {{ section.settings.custom_accent_color.green }}, {{ section.settings.custom_accent_color.blue }};
      --color-button: {{ section.settings.custom_button_color.red }}, {{ section.settings.custom_button_color.green }}, {{ section.settings.custom_button_color.blue }};
      --color-button-text: {{ section.settings.custom_button_text_color.red }}, {{ section.settings.custom_button_text_color.green }}, {{ section.settings.custom_button_text_color.blue }};
      --color-base-outline-button-labels: {{ section.settings.custom_accent_color.red }}, {{ section.settings.custom_accent_color.green }}, {{ section.settings.custom_accent_color.blue }};
    }
  {% endif %}
{%- endstyle -%}

<div class="color-scheme-{{ section.id }} {% if section.settings.color_scheme == 'custom' %}color-custom{% else %}color-{{ section.settings.color_scheme }}{% endif %} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="content-and-results">
      <div class="content-container {{ section.settings.content_alignment }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.title != blank -%}
          <h2 class="title {{ section.settings.heading_size }}">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p>{{ section.settings.subtitle }}</p>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="rte">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>

      <div class="results-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <div class="results">
          <div class="results__rows-container">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'result_item' -%}
                  <div class="results__row" {{ block.shopify_attributes }}>
                    <div class="results__percentage" style="--percentage: {{ block.settings.percentage }}%">
                      <p>{{ block.settings.percentage }}%</p>
                    </div>
                    <div class="results__text">
                      <p>{{ block.settings.text }}</p>
                    </div>
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Results",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Real Results From Our Customers",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        },
        {
          "value": "hxl",
          "label": "Extra Large"
        },
        {
          "value": "hxxl",
          "label": "XX Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "text",
      "id": "subtitle",
      "default": "We ran a consumer trial by distributing the Quivera™ Belt to 88 chiropractic clinics across the United States. A total of 953 patients with neck concerns tested it, and here's what we found.",
      "label": "Subtitle"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Content alignment"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "scheme-1",
          "label": "Scheme 1"
        },
        {
          "value": "scheme-2",
          "label": "Scheme 2"
        },
        {
          "value": "scheme-3",
          "label": "Scheme 3"
        },
        {
          "value": "scheme-4",
          "label": "Scheme 4"
        },
        {
          "value": "scheme-5",
          "label": "Scheme 5"
        },
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "background-1",
      "label": "Color scheme"
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "default": "#ffffff",
      "label": "Custom Background Color",
      "info": "Only applies when Color scheme is set to Custom"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "default": "#2e2a39",
      "label": "Custom Text Color",
      "info": "Only applies when Color scheme is set to Custom"
    },
    {
      "type": "color",
      "id": "custom_accent_color",
      "default": "#dd1d1d",
      "label": "Custom Accent Color",
      "info": "Only applies when Color scheme is set to Custom"
    },
    {
      "type": "color",
      "id": "custom_button_color",
      "default": "#dd1d1d",
      "label": "Custom Button Color",
      "info": "Only applies when Color scheme is set to Custom"
    },
    {
      "type": "color",
      "id": "custom_button_text_color",
      "default": "#ffffff",
      "label": "Custom Button Text Color",
      "info": "Only applies when Color scheme is set to Custom"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "result_item",
      "name": "Result Item",
      "settings": [
        {
          "type": "range",
          "id": "percentage",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Percentage",
          "default": 90
        },
        {
          "type": "text",
          "id": "text",
          "default": "of users reported standing taller and feeling more supported after just 2 days of use.",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Results",
      "blocks": [
        {
          "type": "result_item",
          "settings": {
            "percentage": 92,
            "text": "of users reported standing taller and feeling more supported after just 2 days of use."
          }
        },
        {
          "type": "result_item",
          "settings": {
            "percentage": 90,
            "text": "noticed visible improvements in posture and alignment after 14 days of consistent use (2 hours/day)."
          }
        },
        {
          "type": "result_item",
          "settings": {
            "percentage": 90,
            "text": "reduced slouching and stiffness in the lower back after 10 days of consistent use (2 hours/day)."
          }
        },
        {
          "type": "result_item",
          "settings": {
            "percentage": 87,
            "text": "of users reported reduced sciatica & lower back pain after 2 days of use."
          }
        }
      ]
    }
  ]
}
{% endschema %}
