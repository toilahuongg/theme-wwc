{{ 'component-icon-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Icon with Text Styles */
  .icon-with-text {
    position: relative;
    overflow: hidden;
  }

  .icon-with-text::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* background: linear-gradient(135deg, rgba(37, 99, 235, 0.02) 0%, rgba(2, 132, 199, 0.02) 100%); */
    z-index: 1;
  }

  .icon-with-text__container {
    position: relative;
    z-index: 2;
  }

  .icon-with-text__grid {
    display: grid;
    gap: var(--grid-gap, 2rem);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  /* Grid columns based on settings */
  .icon-with-text__grid--1-columns {
    grid-template-columns: 1fr;
  }

  .icon-with-text__grid--2-columns {
    grid-template-columns: repeat(2, 1fr);
  }

  .icon-with-text__grid--3-columns {
    grid-template-columns: repeat(3, 1fr);
  }

  .icon-with-text__grid--4-columns {
    grid-template-columns: repeat(4, 1fr);
  }

  /* Ensure gap is always applied */
  .icon-with-text__grid[style*="--grid-gap"] {
    gap: var(--grid-gap) !important;
  }



  /* Color scheme styles using Shopify standard variables */
  .icon-block {
    background: rgba(var(--color-background), 0.95);
    border: 1px solid rgba(var(--color-button), 0.08);
  }

  .icon-block .icon-block__heading {
    color: rgb(var(--color-foreground));
  }

  .icon-block .icon-block__text {
    color: rgba(var(--color-foreground), 0.75);
  }

  .icon-block .icon-block__link {
    color: rgb(var(--color-button));
  }

  .icon-block .icon-block__icon {
    background: linear-gradient(135deg, rgb(var(--color-button)), rgb(var(--color-link)));
    color: rgb(var(--color-button-text));
  }

  @media screen and (min-width: 750px) {
    .icon-with-text__grid {
      gap: calc(var(--grid-gap, 2rem) * 1.5);
    }

    /* Responsive grid adjustments */
    .icon-with-text__grid--2-columns,
    .icon-with-text__grid--3-columns,
    .icon-with-text__grid--4-columns {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .icon-with-text__grid {
      gap: calc(var(--grid-gap, 2rem) * 2);
    }

    /* Desktop grid adjustments */
    .icon-with-text__grid--3-columns {
      grid-template-columns: repeat(3, 1fr);
    }

    .icon-with-text__grid--4-columns {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Header Styles */
  .icon-with-text__header {
    margin-bottom: 4rem;
    text-align: center; /* Default center alignment */
  }

  /* Header alignment options */
  .icon-with-text__header--left {
    text-align: left;
  }

  .icon-with-text__header--center {
    text-align: center;
  }

  .icon-with-text__header--right {
    text-align: right;
  }

  .icon-with-text__heading {
    margin-bottom: 1.5rem;
    color: rgb(var(--color-foreground));
    font-weight: 700;
    position: relative;
    line-height: 1.2;
  }

  /* Section heading sizes */
  .icon-with-text__heading--h1 {
    font-size: 3rem;
  }

  .icon-with-text__heading--h2 {
    font-size: 2.5rem;
  }

  .icon-with-text__heading--h3 {
    font-size: 2rem;
  }

  .icon-with-text__heading::after {
    content: '';
    position: absolute;
    bottom: -10px;
    width: 80px;
    height: 4px;
    background: rgb(var(--color-button));
    border-radius: 2px;
    transition: width 0.3s ease;
  }

  /* Underline positioning based on alignment */
  .icon-with-text__header--center .icon-with-text__heading::after {
    left: 50%;
    transform: translateX(-50%);
  }

  .icon-with-text__header--left .icon-with-text__heading::after {
    left: 0;
    transform: none;
  }

  .icon-with-text__header--right .icon-with-text__heading::after {
    right: 0;
    transform: none;
  }

  .icon-with-text__heading:hover::after {
    width: 120px;
  }

  .icon-with-text__subheading {
    font-size: 1.2rem;
    color: rgba(var(--color-foreground), 0.75);
    max-width: 700px;
    line-height: 1.7;
    font-weight: 400;
  }

  /* Subheading margin based on alignment */
  .icon-with-text__header--center .icon-with-text__subheading {
    margin: 0 auto;
  }

  .icon-with-text__header--left .icon-with-text__subheading {
    margin: 0;
  }

  .icon-with-text__header--right .icon-with-text__subheading {
    margin: 0 0 0 auto;
  }

  .icon-with-text__subheading p {
    margin: 0;
  }

  /* Icon Block Styles */
  .icon-block {
    text-align: center;
    padding: 2rem 1.5rem;
    background: rgba(var(--color-background), 0.95);
    border-radius: 16px;
    border: 1px solid rgba(var(--color-accent-1), 0.08);
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
  }

  .icon-block::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(var(--color-button), 0.05), rgba(var(--color-link), 0.05));
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 1;
  }

  .icon-block:hover::before {
    opacity: 1;
  }

  .icon-block:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 40px rgba(var(--color-button), 0.15);
    border-color: rgba(var(--color-button), 0.2);
  }

  .icon-block__content {
    position: relative;
    z-index: 2;
  }

  /* Icon Styles */
  .icon-block__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgb(var(--color-button)), rgb(var(--color-link)));
    color: rgb(var(--color-button-text));
    font-size: 2rem;
    margin-bottom: 1.5rem;
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
  }

  .icon-block__icon::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    /* background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent); */
    transition: left 0.6s ease;
  }

  .icon-block:hover .icon-block__icon::before {
    left: 100%;
  }

  .icon-block:hover .icon-block__icon {
    transform: scale(1.1) rotate(5deg);
    box-shadow: 0 8px 24px rgba(var(--color-button), 0.3);
  }

  /* Icon Size Variations */
  .icon-block__icon--small {
    width: 60px;
    height: 60px;
    font-size: 1.5rem;
  }

  .icon-block__icon--large {
    width: 100px;
    height: 100px;
    font-size: 2.5rem;
  }

  /* Icon Style Variations */
  .icon-block__icon--outlined {
    background: transparent;
    border: 3px solid rgb(var(--color-button));
    color: rgb(var(--color-button));
  }

  .icon-block__icon--outlined:hover {
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
  }

  .icon-block__icon--soft {
    background: rgba(var(--color-button), 0.1);
    color: rgb(var(--color-button));
  }

  .icon-block__icon--soft:hover {
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
  }

  /* Text Styles */
  .icon-block__heading {
    font-size: 1.25rem;
    font-weight: 600;
    color: rgb(var(--color-foreground));
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  .icon-block__text {
    font-size: 0.95rem;
    color: rgba(var(--color-foreground), 0.75);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  /* Font size classes for block text */
  .icon-block__text--xs {
    font-size: 0.8rem !important;
  }

  .icon-block__text--small {
    font-size: 0.9rem !important;
  }

  .icon-block__text--medium {
    font-size: 0.95rem !important;
  }

  .icon-block__text--large {
    font-size: 1rem !important;
  }

  .icon-block__text--xl {
    font-size: 1.1rem !important;
  }

  .icon-block__text--2xl {
    font-size: 1.2rem !important;
  }

  /* Font size classes for block heading */
  .icon-block__heading--xs {
    font-size: 1rem !important;
  }

  .icon-block__heading--small {
    font-size: 1.1rem !important;
  }

  .icon-block__heading--medium {
    font-size: 1.25rem !important;
  }

  .icon-block__heading--large {
    font-size: 1.4rem !important;
  }

  .icon-block__heading--xl {
    font-size: 1.6rem !important;
  }

  .icon-block__heading--2xl {
    font-size: 1.8rem !important;
  }

  .icon-block__heading--3xl {
    font-size: 2rem !important;
  }

  .icon-block__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: rgb(var(--color-accent-1));
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    transition: all 0.3s ease;
  }

  .icon-block__link:hover {
    color: rgba(var(--color-button), 0.8);
    transform: translateX(4px);
  }

  .icon-block__link::after {
    content: '→';
    transition: transform 0.3s ease;
  }

  .icon-block__link:hover::after {
    transform: translateX(4px);
  }

  /* Layout Variations */
  .icon-block--left {
    text-align: left;
  }

  .icon-block--left .icon-block__icon {
    margin-bottom: 1rem;
  }

  .icon-block--right {
    text-align: right;
  }

  .icon-block--right .icon-block__icon {
    margin-bottom: 1rem;
  }

  /* Animation Classes */
  .icon-block--fade-in {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s ease forwards;
  }

  .icon-block--bounce {
    animation: bounce 0.6s ease;
  }

  .icon-block--pulse {
    animation: pulse 2s infinite;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes bounce {
    0%, 20%, 53%, 80%, 100% {
      transform: translateY(0);
    }
    40%, 43% {
      transform: translateY(-10px);
    }
    70% {
      transform: translateY(-5px);
    }
    90% {
      transform: translateY(-2px);
    }
  }

  @keyframes pulse {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
    100% {
      transform: scale(1);
    }
  }

  /* Responsive Design */
  @media screen and (max-width: 749px) {
    .icon-with-text__grid {
      grid-template-columns: 1fr !important;
      gap: calc(var(--grid-gap, 2rem) * 0.75);
    }

    .icon-with-text__header {
      margin-bottom: 2rem;
    }

    /* Mobile alignment adjustments */
    .icon-with-text__header--left,
    .icon-with-text__header--center,
    .icon-with-text__header--right {
      text-align: center; /* Force center on mobile for better readability */
    }

    .icon-with-text__header--left .icon-with-text__heading::after,
    .icon-with-text__header--right .icon-with-text__heading::after {
      left: 50%;
      transform: translateX(-50%);
    }

    .icon-with-text__header--left .icon-with-text__subheading,
    .icon-with-text__header--right .icon-with-text__subheading {
      margin: 0 auto;
    }

    .icon-with-text__heading--h1 {
      font-size: 2rem;
    }

    .icon-with-text__heading--h2 {
      font-size: 1.8rem;
    }

    .icon-with-text__heading--h3 {
      font-size: 1.5rem;
    }

    .icon-with-text__subheading {
      font-size: 1rem;
    }

    .icon-block {
      padding: 1.5rem 1rem;
    }

    .icon-block__icon {
      width: 60px;
      height: 60px;
      font-size: 1.5rem;
      margin-bottom: 1rem;
    }

    .icon-block__heading {
      font-size: 1.1rem;
    }

    .icon-block__text {
      font-size: 0.9rem;
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .icon-block,
    .icon-block__icon,
    .icon-block__link {
      animation: none;
      transition: none;
    }
  }
{%- endstyle -%}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Animate blocks on scroll
    const blocks = document.querySelectorAll('.icon-block');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry, index) => {
          if (entry.isIntersecting) {
            setTimeout(() => {
              entry.target.classList.add('icon-block--fade-in');
            }, index * 100);
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: '50px',
      }
    );

    blocks.forEach((block) => observer.observe(block));

    // Add hover effects for mobile
    if ('ontouchstart' in window) {
      blocks.forEach((block) => {
        block.addEventListener('touchstart', function () {
          this.classList.add('touch-active');
        });

        block.addEventListener('touchend', function () {
          setTimeout(() => {
            this.classList.remove('touch-active');
          }, 300);
        });
      });
    }
  });
</script>

<div class="icon-with-text color-{{ section.settings.color_scheme }} gradient{% unless section.settings.background_style == 'none' and settings.text_boxes_border_thickness > 0 or settings.text_boxes_shadow_opacity > 0 %} background-{{ section.settings.background_style }}{% endunless %}">
  <div class="page-width section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="icon-with-text__container">
      {%- if section.settings.heading != blank -%}
        <div class="icon-with-text__header icon-with-text__header--{{ section.settings.heading_alignment | default: 'center' }}">
          <h2 class="heading icon-with-text__heading icon-with-text__heading--{{ section.settings.section_heading_size | default: 'h1' }}">
            {{ section.settings.heading | escape }}
          </h2>
          {%- if section.settings.subheading != blank -%}
            <div class="icon-with-text__subheading rte">
              <p>{{ section.settings.subheading | escape }}</p>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div
        class="icon-with-text__grid icon-with-text__grid--{{ section.settings.columns_desktop }}-columns"
        style="--grid-gap: {{ section.settings.grid_gap }}rem;"
      >
        {%- for block in section.blocks -%}
          <div
            class="icon-block icon-block--{{ block.settings.alignment }}{% if block.settings.animation != 'none' %} icon-block--{{ block.settings.animation }}{% endif %}{% if section.settings.show_box_shadow %} icon-block--shadow{% endif %} color-{{ section.settings.block_color_scheme }}"
            data-heading-size="{{ section.settings.heading_size | default: 'medium' }}"
            data-text-size="{{ section.settings.text_size | default: 'medium' }}"
            data-show-shadow="{{ section.settings.show_box_shadow }}"
            {{ block.shopify_attributes }}
          >
            <div class="icon-block__content">
              {%- if block.settings.icon != blank -%}
                <div class="icon-block__icon icon-block__icon--{{ block.settings.icon_size }} icon-block__icon--{{ block.settings.icon_style }}">
                  {%- case block.settings.icon -%}
                    {%- when 'water-drop' -%}
                      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2.69L17.66 8.35C19.78 10.47 19.78 13.53 17.66 15.65C15.54 17.77 12.48 17.77 10.36 15.65C8.24 13.53 8.24 10.47 10.36 8.35L12 2.69Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {%- when 'paw-print' -%}
                      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M4.5 9.5C5.5 9.5 6.5 8.5 6.5 7.5C6.5 6.5 5.5 5.5 4.5 5.5C3.5 5.5 2.5 6.5 2.5 7.5C2.5 8.5 3.5 9.5 4.5 9.5Z" stroke="currentColor" stroke-width="2"/>
                        <path d="M9.5 6.5C10.5 6.5 11.5 5.5 11.5 4.5C11.5 3.5 10.5 2.5 9.5 2.5C8.5 2.5 7.5 3.5 7.5 4.5C7.5 5.5 8.5 6.5 9.5 6.5Z" stroke="currentColor" stroke-width="2"/>
                        <path d="M14.5 9.5C15.5 9.5 16.5 8.5 16.5 7.5C16.5 6.5 15.5 5.5 14.5 5.5C13.5 5.5 12.5 6.5 12.5 7.5C12.5 8.5 13.5 9.5 14.5 9.5Z" stroke="currentColor" stroke-width="2"/>
                        <path d="M19.5 6.5C20.5 6.5 21.5 5.5 21.5 4.5C21.5 3.5 20.5 2.5 19.5 2.5C18.5 2.5 17.5 3.5 17.5 4.5C17.5 5.5 18.5 6.5 19.5 6.5Z" stroke="currentColor" stroke-width="2"/>
                        <path d="M9.5 21.5C9.5 18.5 12.5 16.5 15.5 16.5C18.5 16.5 21.5 18.5 21.5 21.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                      </svg>
                    {%- when 'lightning' -%}
                      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M13 2L3 14H12L11 22L21 10H12L13 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {%- when 'home' -%}
                      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3 9L12 2L21 9V20C21 20.5304 20.7893 21.0391 20.4142 21.4142C20.0391 21.7893 19.5304 22 19 22H5C4.46957 22 3.96086 21.7893 3.58579 21.4142C3.21071 21.0391 3 20.5304 3 20V9Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M9 22V12H15V22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {%- when 'target' -%}
                      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                        <circle cx="12" cy="12" r="6" stroke="currentColor" stroke-width="2"/>
                        <circle cx="12" cy="12" r="2" stroke="currentColor" stroke-width="2"/>
                      </svg>
                    {%- when 'star' -%}
                      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {%- when 'shield' -%}
                      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 22S20 18 20 12V5L12 2L4 5V12C4 18 12 22 12 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {%- when 'leaf' -%}
                      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M6 3C6 3 12 3 18 9C12 15 6 15 6 15C6 15 6 9 6 3Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M6 9C6 9 12 9 18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {%- when 'heart' -%}
                      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M20.84 4.61C20.3292 4.099 19.7228 3.69364 19.0554 3.41708C18.3879 3.14052 17.6725 2.99817 16.95 2.99817C16.2275 2.99817 15.5121 3.14052 14.8446 3.41708C14.1772 3.69364 13.5708 4.099 13.06 4.61L12 5.67L10.94 4.61C9.9083 3.5783 8.50903 2.9987 7.05 2.9987C5.59096 2.9987 4.19169 3.5783 3.16 4.61C2.1283 5.6417 1.5487 7.04097 1.5487 8.5C1.5487 9.95903 2.1283 11.3583 3.16 12.39L12 21.23L20.84 12.39C21.351 11.8792 21.7564 11.2728 22.0329 10.6054C22.3095 9.93789 22.4518 9.22249 22.4518 8.5C22.4518 7.77751 22.3095 7.0621 22.0329 6.39464C21.7564 5.72718 21.351 5.12075 20.84 4.61Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {%- when 'check' -%}
                      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                  {%- endcase -%}
                </div>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                <h3 class="icon-block__heading icon-block__heading--{{ section.settings.heading_size | default: 'medium' }}">
                  {{ block.settings.heading | escape }}
                </h3>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="icon-block__text icon-block__text--{{ section.settings.text_size | default: 'medium' }} rte">
                  {{ block.settings.text }}
                </div>
              {%- endif -%}

              {%- if block.settings.link_text != blank and block.settings.link_url != blank -%}
                <a href="{{ block.settings.link_url }}" class="icon-block__link">
                  {{ block.settings.link_text | escape }}
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size == 0 -%}
        <div class="icon-with-text__placeholder">
          <div class="icon-block">
            <div class="icon-block__content">
              <div class="icon-block__icon">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2.69L17.66 8.35C19.78 10.47 19.78 13.53 17.66 15.65C15.54 17.77 12.48 17.77 10.36 15.65C8.24 13.53 8.24 10.47 10.36 8.35L12 2.69Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <h3 class="icon-block__heading">Add your first icon block</h3>
              <div class="icon-block__text">
                <p>Click "Add block" to create your first icon with text block.</p>
              </div>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

