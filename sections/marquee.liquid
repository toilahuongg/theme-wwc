{{ 'section-marquee.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-marquee.js' | asset_url }}" defer></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .marquee-{{ section.id }} {
    --marquee-speed: {{ section.settings.speed }}s;
    --marquee-direction: {{ section.settings.direction }};
    --marquee-pause-on-hover: {{ section.settings.pause_on_hover }};
    --marquee-font-size: {{ section.settings.font_size }}px;
    --marquee-font-weight: {{ section.settings.font_weight }};
    --marquee-font-style: {{ section.settings.italic }};
  }

  {% if section.settings.direction == 'right' %}
  .marquee-{{ section.id }} .marquee__content {
    animation-direction: reverse;
  }
  {% endif %}
{%- endstyle -%}

<div class="marquee-{{ section.id }} marquee section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="marquee__content">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'text' -%}
          <span
            class="marquee__item"
            {{ block.shopify_attributes }}
            style="font-size: {{ block.settings.font_size | default: section.settings.font_size }}px; font-weight: {{ block.settings.font_weight | default: section.settings.font_weight }}; font-style: {{ block.settings.italic | default: section.settings.italic }};"
          >
            {%- if block.settings.icon_svg != blank -%}
              <span class="marquee__item-icon">
                {{ block.settings.icon_svg }}
              </span>
            {%- endif -%}
            {{ block.settings.text | escape }}
          </span>
        {%- when 'icon' -%}
          <span class="marquee__item marquee__item--icon" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              {{ block.settings.icon }}
            {%- endif -%}
          </span>
        {%- when 'image' -%}
          <span class="marquee__item marquee__item--image" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 50
                | image_tag:
                  loading: 'lazy',
                  width: block.settings.image_width,
                  height: block.settings.image_height,
                  alt: block.settings.image.alt
                | escape
              }}
            {%- endif -%}
          </span>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.duplicate_content -%}
    <div class="marquee__content" aria-hidden="true">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'text' -%}
            <span
              class="marquee__item"
              style="font-size: {{ section.settings.font_size }}px; font-weight: {{ section.settings.font_weight }}; font-style: {{ section.settings.italic }};"
            >
              {%- if block.settings.icon_svg != blank -%}
                <span class="marquee__item-icon">
                  {{ block.settings.icon_svg }}
                </span>
              {%- endif -%}
              {{ block.settings.text | escape }}
            </span>
          {%- when 'icon' -%}
            <span class="marquee__item marquee__item--icon">
              {%- if block.settings.icon != blank -%}
                {{ block.settings.icon }}
              {%- endif -%}
            </span>
          {%- when 'image' -%}
            <span class="marquee__item marquee__item--image">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 50
                  | image_tag:
                    loading: 'lazy',
                    width: block.settings.image_width,
                    height: block.settings.image_height,
                    alt: block.settings.image.alt
                  | escape
                }}
              {%- endif -%}
            </span>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.marquee.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "s",
      "label": "t:sections.marquee.settings.speed.label",
      "default": 5,
      "info": "t:sections.marquee.settings.speed.info"
    },
    {
      "type": "select",
      "id": "direction",
      "options": [
        {
          "value": "left",
          "label": "t:sections.marquee.settings.direction.options__1.label"
        },
        {
          "value": "right",
          "label": "t:sections.marquee.settings.direction.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.marquee.settings.direction.label"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "default": true,
      "label": "t:sections.marquee.settings.pause_on_hover.label"
    },
    {
      "type": "checkbox",
      "id": "duplicate_content",
      "default": true,
      "label": "t:sections.marquee.settings.duplicate_content.label",
      "info": "t:sections.marquee.settings.duplicate_content.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "select",
      "id": "font_weight",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "bold",
          "label": "Bold"
        },
        {
          "value": "100",
          "label": "Thin (100)"
        },
        {
          "value": "200",
          "label": "Extra Light (200)"
        },
        {
          "value": "300",
          "label": "Light (300)"
        },
        {
          "value": "400",
          "label": "Regular (400)"
        },
        {
          "value": "500",
          "label": "Medium (500)"
        },
        {
          "value": "600",
          "label": "Semi Bold (600)"
        },
        {
          "value": "700",
          "label": "Bold (700)"
        },
        {
          "value": "800",
          "label": "Extra Bold (800)"
        },
        {
          "value": "900",
          "label": "Black (900)"
        }
      ],
      "default": "normal",
      "label": "Font weight"
    },
    {
      "type": "select",
      "id": "italic",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "italic",
          "label": "Italic"
        }
      ],
      "default": "normal",
      "label": "Font style"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "t:sections.marquee.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Marquee text",
          "label": "t:sections.marquee.blocks.text.settings.text.label"
        },
        {
          "type": "textarea",
          "id": "icon_svg",
          "label": "Icon"
        }
      ]
    },
    {
      "type": "icon",
      "name": "t:sections.marquee.blocks.icon.name",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "default": "★",
          "label": "t:sections.marquee.blocks.icon.settings.icon.label",
          "info": "t:sections.marquee.blocks.icon.settings.icon.info"
        }
      ]
    },
    {
      "type": "image",
      "name": "t:sections.marquee.blocks.image.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.marquee.blocks.image.settings.image.label"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 20,
          "max": 100,
          "step": 5,
          "unit": "px",
          "label": "t:sections.marquee.blocks.image.settings.image_width.label",
          "default": 30
        },
        {
          "type": "range",
          "id": "image_height",
          "min": 20,
          "max": 100,
          "step": 5,
          "unit": "px",
          "label": "t:sections.marquee.blocks.image.settings.image_height.label",
          "default": 30
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.marquee.presets.name",
      "blocks": [
        {
          "type": "text"
        },
        {
          "type": "icon"
        },
        {
          "type": "text"
        }
      ]
    }
  ]
}
{% endschema %}
