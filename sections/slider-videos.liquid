<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css">
{{ 'section-slider-videos.css' | asset_url | stylesheet_tag }}
{{ 'component-rte.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {% if section.settings.color_scheme == 'custom' %}
    .color-scheme-{{ section.id }}.color-custom {
      --color-background: {{ section.settings.custom_bg_color.red }}, {{ section.settings.custom_bg_color.green }}, {{ section.settings.custom_bg_color.blue }};
      --gradient-background: {{ section.settings.custom_bg_color }};
      --color-foreground: {{ section.settings.custom_text_color.red }}, {{ section.settings.custom_text_color.green }}, {{ section.settings.custom_text_color.blue }};
      --accent-color: {{ section.settings.custom_accent_color.red }}, {{ section.settings.custom_accent_color.green }}, {{ section.settings.custom_accent_color.blue }};
      --color-button: {{ section.settings.custom_button_color.red }}, {{ section.settings.custom_button_color.green }}, {{ section.settings.custom_button_color.blue }};
      --color-button-text: {{ section.settings.custom_button_text_color.red }}, {{ section.settings.custom_button_text_color.green }}, {{ section.settings.custom_button_text_color.blue }};
      --color-base-outline-button-labels: {{ section.settings.custom_accent_color.red }}, {{ section.settings.custom_accent_color.green }}, {{ section.settings.custom_accent_color.blue }};
    }
  {% endif %}
{%- endstyle -%}

<div class="color-scheme-{{ section.id }} {% if section.settings.color_scheme == 'custom' %}color-custom{% else %}color-{{ section.settings.color_scheme }}{% endif %} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="slider-videos">
      <div class="slider-videos-container {{ section.settings.content_alignment }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.title != blank -%}
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p>{{ section.settings.subtitle }}</p>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="rte">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>

      <div class="slider-videos-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <div class="splide" id="slider-videos-{{ section.id }}">
          <div class="splide__track">
            <ul class="splide__list">
              {%- for block in section.blocks -%}
                {%- case block.type -%}
                  {%- when 'slider_video_item' -%}
                    <li class="splide__slide" {{ block.shopify_attributes }}>
                      <slider-video-item
                        src="{{ block.settings.video.sources[1].url }}"
                        title="{{ block.settings.title }}"
                        description="{{ block.settings.description }}"
                        autoplay
                        muted
                        loop
                        playsinline
                      >
                      </slider-video-item>
                    </li>
                {%- endcase -%}
              {%- endfor -%}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Splide JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js"></script>

<!-- Web Components -->
<script type="module" src="{{ 'slider-video-item.js' | asset_url }}"></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Initialize Splide
    const splide = new Splide('#slider-videos-{{ section.id }}', {
      type: 'loop',
      perPage: {{ section.settings.slides_to_show }},
      perMove: 1,
      gap: '{{ section.settings.slider_gap }}px',
      padding: '{{ section.settings.slider_padding }}px',
      autoplay: {{ section.settings.autoplay }},
      interval: {{ section.settings.autoplay_interval }},
      pauseOnHover: {{ section.settings.pause_on_hover }},
      pauseOnFocus: false,
      resetProgress: false,
      arrows: true,
      pagination: false,
      drag: true,
      keyboard: true,
      focus: 'center',
      trimSpace: false,
      updateOnMove: true,
      classes: {
        pagination: 'splide__pagination custom-pagination',
        page: 'splide__pagination__page custom-page',
      },
    });


    // Mount the slider
    splide.mount();

      // Get all slider-video-item elements
      const videoItems = document.querySelectorAll('slider-video-item');
      let autoplayEnabled = true;
      let userHasInteracted = false;

      // Track user interaction for autoplay policy compliance
      const handleUserInteraction = () => {
        userHasInteracted = true;
        // Try to play all visible videos after user interaction
        if (autoplayEnabled) {
          playVisibleVideos();
        }
      };

      document.addEventListener('click', handleUserInteraction);
      document.addEventListener('touchstart', handleUserInteraction);
      document.addEventListener('keydown', handleUserInteraction);

      // Store all visible video references
      let visibleVideos = new Set();

      // Function to get all currently visible videos
      function getVisibleVideos() {
        const visible = new Set();

        // Use a more reliable method to get slides
        const slideElements = document.querySelectorAll('.splide__slide');

        slideElements.forEach((slideElement) => {
          if (slideElement.classList.contains('is-visible') ||
              slideElement.classList.contains('is-active')) {
            const videoItem = slideElement.querySelector('slider-video-item');
            if (videoItem) {
              visible.add(videoItem);
            }
          }
        });

        return visible;
      }

      // Function to play all visible videos
      function playVisibleVideos() {
        if (!autoplayEnabled || !userHasInteracted) return;

        try {
          const currentVisible = getVisibleVideos();
          currentVisible.forEach(videoItem => {
            if (videoItem && !videoItem.isPlaying()) {
              videoItem.play().catch(e => {
                if (e.message !== 'User interaction required') {
                  console.log('Video autoplay failed:', e);
                }
              });
            }
          });
        } catch (error) {
          console.log('Error in playVisibleVideos:', error);
        }
      }

      // Function to pause videos that are no longer visible
      function pauseInvisibleVideos() {
        try {
          const currentVisible = getVisibleVideos();

          // Pause videos that were visible before but are not visible now
          visibleVideos.forEach(videoItem => {
            if (videoItem && !currentVisible.has(videoItem) && videoItem.isPlaying()) {
              videoItem.pause();
            }
          });

          // Update visible videos set
          visibleVideos = currentVisible;
        } catch (error) {
          console.log('Error in pauseInvisibleVideos:', error);
        }
      }

      // Handle slide changes
      splide.on('moved', function() {
        pauseInvisibleVideos();
        playVisibleVideos();
        console.log('Slide changed, video visibility updated');
      });

      // Handle when a slide becomes active (center slide)
      splide.on('active', function() {
        // Small delay to ensure DOM is updated
        setTimeout(() => {
          pauseInvisibleVideos();
          playVisibleVideos();
        }, 50);
      });

      // Auto-play visible videos when slider starts
      splide.on('mounted', function() {
        // Wait a bit for the slider to fully initialize
        setTimeout(() => {
          if (userHasInteracted) {
            playVisibleVideos();
          }
        }, 100);
      });

    // Keyboard controls
    document.addEventListener('keydown', function(e) {
      switch(e.key) {
        case 'ArrowLeft':
          splide.go('-');
          break;
        case 'ArrowRight':
          splide.go('+');
          break;
        case ' ':
          e.preventDefault();
          if (autoplayEnabled) {
            // Pause slider autoplay and all visible videos
            splide.pause();
            visibleVideos.forEach(videoItem => {
              if (videoItem && videoItem.isPlaying()) {
                videoItem.pause();
              }
            });
            autoplayEnabled = false;
            console.log('Autoplay disabled');
          } else {
            // Resume slider autoplay and play all visible videos
            splide.play();
            autoplayEnabled = true;
            if (userHasInteracted) {
              playVisibleVideos();
            }
            console.log('Autoplay enabled');
          }
          break;
      }
    });

    // Touch/swipe support for mobile
    let startX = 0;
    let startY = 0;

    document.addEventListener('touchstart', function(e) {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
    });

    document.addEventListener('touchend', function(e) {
      if (!startX || !startY) return;

      const endX = e.changedTouches[0].clientX;
      const endY = e.changedTouches[0].clientY;

      const diffX = startX - endX;
      const diffY = startY - endY;

      // Only trigger if horizontal swipe is more significant than vertical
      if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 50) {
        if (diffX > 0) {
          splide.go('+');
        } else {
          splide.go('-');
        }
      }

      startX = 0;
      startY = 0;
    });

    console.log('Splide Video Slider initialized successfully!');
  });
</script>

{% schema %}
{
  "name": "Slider Videos",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Slider videos",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        },
        {
          "value": "hxl",
          "label": "Extra Large"
        },
        {
          "value": "hxxl",
          "label": "XX Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Content alignment"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "scheme-1",
          "label": "Scheme 1"
        },
        {
          "value": "scheme-2",
          "label": "Scheme 2"
        },
        {
          "value": "scheme-3",
          "label": "Scheme 3"
        },
        {
          "value": "scheme-4",
          "label": "Scheme 4"
        },
        {
          "value": "scheme-5",
          "label": "Scheme 5"
        },
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "background-1",
      "label": "Color scheme"
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "default": "#ffffff",
      "label": "Custom Background Color",
      "info": "Only applies when Color scheme is set to Custom"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "default": "#2e2a39",
      "label": "Custom Text Color",
      "info": "Only applies when Color scheme is set to Custom"
    },
    {
      "type": "color",
      "id": "custom_accent_color",
      "default": "#dd1d1d",
      "label": "Custom Accent Color",
      "info": "Only applies when Color scheme is set to Custom"
    },
    {
      "type": "color",
      "id": "custom_button_color",
      "default": "#dd1d1d",
      "label": "Custom Button Color",
      "info": "Only applies when Color scheme is set to Custom"
    },
    {
      "type": "color",
      "id": "custom_button_text_color",
      "default": "#ffffff",
      "label": "Custom Button Text Color",
      "info": "Only applies when Color scheme is set to Custom"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "range",
      "id": "slides_to_show",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Number of slides to show",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 2000,
      "max": 9500,
      "step": 500,
      "unit": "ms",
      "label": "Autoplay Interval",
      "default": 8000
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": false
    },
    {
      "type": "range",
      "id": "slider_gap",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Gap Between Slides",
      "default": 20
    },
    {
      "type": "range",
      "id": "slider_padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Slider Padding",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "slider_video_item",
      "name": "Sliver Video Item",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Amazing Product"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "This product changed my life! I can't imagine living without it."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slider Videos",
      "blocks": []
    }
  ]
}
{% endschema %}
