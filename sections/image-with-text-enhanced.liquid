{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Enhanced Styles for Pet Water Filter Theme */
  .image-with-text-enhanced {
    position: relative;
    overflow: hidden;
  }

  .image-with-text-enhanced::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* background: linear-gradient(135deg, rgba(37, 99, 235, 0.05) 0%, rgba(2, 132, 199, 0.05) 100%); */
    z-index: 1;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .image-with-text-enhanced:hover::before {
    opacity: 1;
  }

  .image-with-text-enhanced__media {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(37, 99, 235, 0.15);
    transition: all 0.4s ease;
  }

  /* Override default border-radius for shaped containers */
  .image-with-text-enhanced__media:not(.image-with-text-enhanced__media--default) {
    border-radius: 0;
  }

  .image-with-text-enhanced__media:hover {
    transform: translateY(-8px);

    box-shadow: 0 16px 48px rgba(37, 99, 235, 0.25);
  }

  .image-with-text-enhanced__media img {
    transition: transform 0.6s ease;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-with-text-enhanced__media:hover img {
    transform: scale(1.05);
  }

  /* Prevent hover effects on mobile */
  @media (hover: none) and (pointer: coarse) {
    .image-with-text-enhanced__media:hover {
      transform: none;
      box-shadow: 0 8px 32px rgba(37, 99, 235, 0.15);
    }

    .image-with-text-enhanced__media:hover img {
      transform: none;
    }
  }

  /* Image Shape Variations */
  .image-with-text-enhanced__media--circle {
    border-radius: 50% !important;
    overflow: hidden;
  }

  .image-with-text-enhanced__media--rounded {
    border-radius: 24px !important;
    overflow: hidden;
  }

  .image-with-text-enhanced__media--hexagon {
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    border-radius: 0 !important;
    overflow: hidden;
  }

  .image-with-text-enhanced__media--diamond {
    clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
    border-radius: 0 !important;
    overflow: hidden;
  }

  .image-with-text-enhanced__media--wave {
    border-radius: 30% 70% 70% 30% / 30% 30% 70% 70% !important;
    overflow: hidden;
  }

  .image-with-text-enhanced__media--arch {
    border-radius: 50% 50% 0 0 / 100% 100% 0 0 !important;
    overflow: hidden;
  }

  .image-with-text-enhanced__media--dome {
    border-radius: 50% 50% 0 0 / 60% 60% 0 0 !important;
    overflow: hidden;
  }

  .image-with-text-enhanced__media--gothic {
    clip-path: polygon(0 0, 100% 0, 100% 70%, 50% 100%, 0 70%);
    border-radius: 0 !important;
    overflow: hidden;
  }

  /* Ensure images inside shaped containers also get clipped */
  .image-with-text-enhanced__media--hexagon img,
  .image-with-text-enhanced__media--diamond img,
  .image-with-text-enhanced__media--gothic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Ensure all shaped images maintain their shape */
  .image-with-text-enhanced__media--circle img,
  .image-with-text-enhanced__media--rounded img,
  .image-with-text-enhanced__media--wave img,
  .image-with-text-enhanced__media--arch img,
  .image-with-text-enhanced__media--dome img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Image Overlay Effects */
  .image-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.3), rgba(2, 132, 199, 0.3));
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 2;
    pointer-events: none;
  }

  .image-with-text-enhanced__media:hover .image-overlay {
    opacity: 1;
  }

  /* Image Badge */
  .image-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: linear-gradient(135deg, #2563EB, #0284C7);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 600;
    z-index: 3;
    transform: translateY(-10px);
    opacity: 0;
    transition: all 0.3s ease;
  }

  .image-with-text-enhanced__media:hover .image-badge {
    transform: translateY(0);
    opacity: 1;
  }

  /* Image Frame */
  .image-frame {
    position: absolute;
    top: -8px;
    left: -8px;
    right: -8px;
    bottom: -8px;
    border: 3px solid #2563EB;
    border-radius: 20px;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 1;
    pointer-events: none;
  }

  .image-with-text-enhanced__media:hover .image-frame {
    opacity: 1;
  }

  /* Image Parallax Effect */
  .image-parallax {
    transform: translateZ(0);
    will-change: transform;
  }

  /* Image Tilt Effect */
  .image-tilt {
    transform-style: preserve-3d;
    perspective: 1000px;
  }

  .image-tilt img {
    transform: rotateX(0deg) rotateY(0deg);
    transition: transform 0.3s ease;
  }

  .image-with-text-enhanced__media:hover.image-tilt img {
    transform: rotateX(5deg) rotateY(5deg);
  }

  /* Image Glitch Effect */
  .image-glitch {
    position: relative;
  }

  .image-glitch::before,
  .image-glitch::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: inherit;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .image-glitch::before {
    filter: hue-rotate(90deg);
    transform: translateX(-2px);
  }

  .image-glitch::after {
    filter: hue-rotate(180deg);
    transform: translateX(2px);
  }

  .image-with-text-enhanced__media:hover.image-glitch::before,
  .image-with-text-enhanced__media:hover.image-glitch::after {
    opacity: 0.3;
  }

  /* Image Neon Glow */
  .image-neon {
    box-shadow: 0 0 20px rgba(37, 99, 235, 0.3);
  }

  .image-with-text-enhanced__media:hover.image-neon {
    box-shadow: 0 0 40px rgba(37, 99, 235, 0.6);
  }

  /* Image Polaroid Effect */
  .image-polaroid {
    background: white;
    padding: 1rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    border-radius: 8px;
  }

  .image-polaroid img {
    border-radius: 8px;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Image Vintage Effect */
  .image-vintage img {
    filter: sepia(0.3) contrast(1.1) brightness(0.9);
  }

  .image-with-text-enhanced__media:hover.image-vintage img {
    filter: sepia(0) contrast(1) brightness(1);
  }

  /* Image Water Ripple Effect */
  .image-ripple {
    position: relative;
  }

  .image-ripple::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    background: rgba(37, 99, 235, 0.2);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: all 0.6s ease;
    z-index: 2;
    pointer-events: none;
  }

  .image-with-text-enhanced__media:hover.image-ripple::before {
    width: 200px;
    height: 200px;
  }

  .image-with-text-enhanced__content {
    position: relative;
    z-index: 2;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    transition: all 0.4s ease;
  }

  /* Floating Elements */
  .floating-element {
    position: absolute;
    z-index: 1;
    animation: float 6s ease-in-out infinite;
  }

  .floating-element--water-drop {
    top: 10%;
    right: 10%;
    font-size: 2rem;
    color: #0284C7;
    animation-delay: 0s;
  }

  .floating-element--paw-print {
    bottom: 15%;
    left: 5%;
    font-size: 1.5rem;
    color: #F59E0B;
    animation-delay: 2s;
  }

  .floating-element--leaf {
    top: 60%;
    right: 5%;
    font-size: 1.2rem;
    color: #10B981;
    animation-delay: 4s;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(5deg); }
  }

  /* Enhanced Button Styles */
  .button-enhanced {
    position: relative;
    overflow: hidden;
    border-radius: var(--buttons-radius);
    font-weight: 500;
    letter-spacing: 0.025em;
    transition: all 0.2s ease;
    border: var(--buttons-border-width) solid rgba(var(--color-button), var(--buttons-border-opacity));
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    box-shadow: var(--buttons-shadow-visible, 0) var(--buttons-shadow-horizontal-offset) var(--buttons-shadow-vertical-offset) var(--buttons-shadow-blur-radius) rgba(var(--color-shadow), var(--buttons-shadow-opacity));
  }

  .button-enhanced::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transition: left 0.5s ease;
  }

  .button-enhanced:hover::before {
    left: 100%;
  }

  .button-enhanced:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(var(--color-shadow), 0.25);
  }

  .button-enhanced:focus-visible {
    outline: 2px solid rgba(var(--color-button), 0.5);
    outline-offset: 2px;
  }

  /* Enhanced Heading */
  .heading-enhanced {
    position: relative;
    display: inline-block;
  }

  .heading-enhanced::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 0;
    height: 3px;
    background: linear-gradient(90deg, #2563EB, #0284C7);
    transition: width 0.6s ease;
  }

  .heading-enhanced:hover::after {
    width: 100%;
  }



  /* Feature Icons */
  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2563EB, #0284C7);
    color: white;
    font-size: 1.5rem;
    margin-right: 1rem;
    transition: all 0.3s ease;
  }

  .feature-icon:hover {
    transform: scale(1.1) rotate(5deg);
    box-shadow: 0 4px 16px rgba(37, 99, 235, 0.3);
  }

  /* Testimonial Card */
  .testimonial-card {
    background: linear-gradient(135deg, #F0F9FF, #DBEAFE);
    border-radius: 12px;
    padding: 1.5rem;
    margin: 1rem 0;
    border-left: 4px solid #2563EB;
    position: relative;
    overflow: hidden;
  }

  .testimonial-card::before {
    content: '"';
    position: absolute;
    top: -10px;
    right: 20px;
    font-size: 4rem;
    color: rgba(37, 99, 235, 0.1);
    font-family: serif;
  }

  /* Star Rating */
  .star-rating {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-bottom: 1rem;
  }

  .star {
    color: #FBBF24;
    font-size: 1.2rem;
    transition: all 0.2s ease;
  }

  .star:hover {
    transform: scale(1.1);
  }

  .star.filled {
    color: #F59E0B;
  }

  .star.empty {
    color: #E5E7EB;
  }

  .rating-text {
    margin-left: 0.5rem;
    font-size: 0.875rem;
    color: #6B7280;
    font-weight: 500;
  }

  /* Stats Counter */
  .stats-counter {
    display: flex;
    justify-content: space-between;
    margin: 2rem 0;
    text-align: center;
    gap: 1rem;
    width: 100%;
  }

  .stat-item {
    flex: 1;
    padding: 1.5rem;
    background: rgba(37, 99, 235, 0.05);
    border-radius: 12px;
    border: 1px solid rgba(37, 99, 235, 0.1);
    transition: all 0.3s ease;
  }

  .stat-item:hover {
    background: rgba(37, 99, 235, 0.1);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(37, 99, 235, 0.15);
  }

  .stat-number {
    font-size: 2.5rem;
    font-weight: 700;
    color: #2563EB;
    display: block;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-size: 0.875rem;
    color: #6B7280;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* Responsive Enhancements */
  @media screen and (max-width: 749px) {
    .image-with-text-enhanced__content {
      padding: 1.5rem;
      margin-top: 1rem;
    }

    .floating-element {
      display: none;
    }

    .stats-counter {
      flex-direction: column;
      gap: 1rem;
    }

    .stat-item {
      padding: 1rem;
    }

    .stat-number {
      font-size: 2rem;
    }

    .stat-label {
      font-size: 0.75rem;
    }

    /* Mobile Image Effects */
    .image-with-text-enhanced__media--hexagon,
    .image-with-text-enhanced__media--diamond {
      clip-path: none;
      border-radius: 16px;
    }

    .image-tilt img {
      transform: none !important;
    }

    .image-glitch::before,
    .image-glitch::after {
      display: none;
    }

    .image-badge {
      font-size: 0.75rem;
      padding: 0.25rem 0.75rem;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .stats-counter {
      gap: 0.5rem;
    }

    .stat-item {
      padding: 1.25rem;
    }

    .stat-number {
      font-size: 2.25rem;
    }
  }


  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .floating-element,
    .image-with-text-enhanced__media,
    .image-with-text-enhanced__content,
    .button-enhanced {
      animation: none;
      transition: none;
    }
  }

  /* Fix for Safari and older browsers */
  @supports not (clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%)) {
    .image-with-text-enhanced__media--hexagon,
    .image-with-text-enhanced__media--diamond,
    .image-with-text-enhanced__media--gothic {
      clip-path: none;
      border-radius: 16px;
    }
  }

  /* Ensure proper stacking context */
  .image-with-text-enhanced__media {
    transform: translateZ(0);
  }

  /* Force shapes to work with all height settings */
  .image-with-text-enhanced__media--circle.image-with-text__media--adapt,
  .image-with-text-enhanced__media--rounded.image-with-text__media--adapt,
  .image-with-text-enhanced__media--wave.image-with-text__media--adapt,
  .image-with-text-enhanced__media--arch.image-with-text__media--adapt,
  .image-with-text-enhanced__media--dome.image-with-text__media--adapt,
  .image-with-text-enhanced__media--gothic.image-with-text__media--adapt {
    aspect-ratio: auto;
  }

  /* Ensure shapes work with all color schemes */
  .image-with-text-enhanced__media--circle,
  .image-with-text-enhanced__media--rounded,
  .image-with-text-enhanced__media--wave,
  .image-with-text-enhanced__media--hexagon,
  .image-with-text-enhanced__media--diamond,
  .image-with-text-enhanced__media--arch,
  .image-with-text-enhanced__media--dome,
  .image-with-text-enhanced__media--gothic {
    position: relative;
    z-index: 1;
  }

  /* Touch effects for mobile */
  .image-with-text-enhanced__media.touch-active {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 12px 40px rgba(37, 99, 235, 0.3);
  }

  /* Fix for image scaling issues */
  .image-with-text-enhanced__media img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  /* Ensure proper aspect ratio for shaped images */
  .image-with-text-enhanced__media--circle,
  .image-with-text-enhanced__media--hexagon,
  .image-with-text-enhanced__media--diamond {
    aspect-ratio: 1;
  }

  .image-with-text-enhanced__media--wave {
    aspect-ratio: 4/3;
  }

  .image-with-text-enhanced__media--arch,
  .image-with-text-enhanced__media--dome {
    aspect-ratio: 3/4;
  }

  .image-with-text-enhanced__media--gothic {
    aspect-ratio: 4/5;
  }

  /* Fix for wave shape on different aspect ratios */
  .image-with-text-enhanced__media--wave.image-with-text__media--adapt,
  .image-with-text-enhanced__media--arch.image-with-text__media--adapt,
  .image-with-text-enhanced__media--dome.image-with-text__media--adapt,
  .image-with-text-enhanced__media--gothic.image-with-text__media--adapt {
    aspect-ratio: auto;
  }

  /* Ensure frame effect works with all shapes */
  .image-frame {
    border-radius: inherit;
  }

  /* Ensure overlay effects work with all shapes */
  .image-overlay {
    border-radius: inherit;
  }
{%- endstyle -%}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Enhanced image effects initialization
    const imageContainers = document.querySelectorAll('.image-with-text-enhanced__media');

    imageContainers.forEach((container) => {
      // Add intersection observer for performance
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.style.opacity = '1';
              entry.target.style.transform = 'translateY(0)';
            }
          });
        },
        {
          threshold: 0.1,
          rootMargin: '50px',
        }
      );

      observer.observe(container);

      // Enhanced hover effects for mobile
      if ('ontouchstart' in window) {
        container.addEventListener('touchstart', function () {
          this.classList.add('touch-active');
        });

        container.addEventListener('touchend', function () {
          setTimeout(() => {
            this.classList.remove('touch-active');
          }, 300);
        });
      }
    });

    // Fix for Safari clip-path issues
    const isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);
    if (isSafari) {
      const shapedImages = document.querySelectorAll(
        '.image-with-text-enhanced__media--hexagon, .image-with-text-enhanced__media--diamond, .image-with-text-enhanced__media--gothic'
      );
      shapedImages.forEach((img) => {
        img.style.clipPath = 'none';
        img.style.borderRadius = '16px';
      });
    }

    // Debug and ensure shapes are working
    const shapedContainers = document.querySelectorAll(
      '.image-with-text-enhanced__media--circle, .image-with-text-enhanced__media--rounded, .image-with-text-enhanced__media--wave, .image-with-text-enhanced__media--arch, .image-with-text-enhanced__media--dome, .image-with-text-enhanced__media--gothic'
    );

    shapedContainers.forEach((container) => {
      // Force reflow to ensure styles are applied
      container.offsetHeight;

      // Log for debugging
      console.log('Shape applied:', container.className);
    });
  });
</script>

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  if section.settings.color_scheme == section.settings.section_color_scheme and section.settings.content_layout == 'no-overlap'
    assign remove_color_classes = true
  endif
-%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}">
  <div class="page-width">
    <div class="image-with-text-enhanced image-with-text image-with-text--{{ section.settings.content_layout }} isolate{% if settings.text_boxes_border_thickness > 0 and settings.text_boxes_border_opacity > 0 and settings.media_border_thickness > 0 and settings.media_border_opacity > 0 %} collapse-borders{% endif %}{% unless section.settings.color_scheme == section.settings.section_color_scheme and settings.media_border_thickness > 0 and settings.text_boxes_shadow_opacity == 0 and settings.text_boxes_border_thickness == 0 or settings.text_boxes_border_opacity == 0 %} collapse-corners{% endunless %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <!-- Floating Elements -->
      {% if section.settings.show_floating_elements %}
        <div class="floating-element floating-element--water-drop">💧</div>
        <div class="floating-element floating-element--paw-print">🐾</div>
        <div class="floating-element floating-element--leaf">🌿</div>
      {% endif %}

      <div class="image-with-text__grid grid grid--gapless grid--1-col grid--{% if section.settings.desktop_image_width == 'medium' %}2-col-tablet{% else %}3-col-tablet{% endif %}{% if section.settings.layout == 'text_first' %} image-with-text__grid--reverse{% endif %}">
        <div class="image-with-text__media-item image-with-text__media-item--{{ section.settings.desktop_image_width }} image-with-text__media-item--{{ section.settings.desktop_content_position }} grid__item">
          <div
            class="image-with-text-enhanced__media image-with-text__media image-with-text__media--{{ section.settings.height }} global-media-settings{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}{% if section.settings.image != blank %} media{% else %} image-with-text__media--placeholder placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if section.settings.image_shape != 'default' %} image-with-text-enhanced__media--{{ section.settings.image_shape }}{% endif %}{% if section.settings.image_effect != 'none' %} image-{{ section.settings.image_effect }}{% endif %}"
            {% if section.settings.height == 'adapt' and section.settings.image != blank %}
              style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
            {% endif %}
          >
            {%- if section.settings.image_effect == 'frame' -%}
              <div class="image-frame"></div>
            {%- endif -%}

            {%- if section.settings.image_effect == 'overlay' -%}
              <div class="image-overlay"></div>
            {%- endif -%}

            {%- if section.settings.image_badge != blank -%}
              <div class="image-badge">{{ section.settings.image_badge }}</div>
            {%- endif -%}
            {%- if section.settings.image != blank -%}
              {%- if section.settings.image_behavior == 'ambient' or section.settings.image_behavior == 'zoom-in' -%}
                {%- assign widths = '198, 432, 642, 900, 1284, 1800' -%}
                {%- capture sizes -%}
              (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 1.6667 }}px,
              (min-width: 750px) calc((100vw - 130px) / 1.667), calc((100vw - 50px) / 1.667)
            {%- endcapture -%}
              {%- else -%}
                {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
                {%- capture sizes -%}
              (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
              (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
            {%- endcapture -%}
              {%- endif -%}
              {{
                section.settings.image
                | image_url: width: 1500
                | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
              }}
            {%- else -%}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
        <div class="image-with-text__text-item grid__item">
          <div
            id="ImageWithText--{{ section.id }}"
            class="image-with-text-enhanced__content image-with-text__content image-with-text__content--{{ section.settings.desktop_content_position }} image-with-text__content--desktop-{{ section.settings.desktop_content_alignment }} image-with-text__content--mobile-{{ section.settings.mobile_content_alignment }} image-with-text__content--{{ section.settings.height }} content-container{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}"
          >
            {%- for block in section.blocks -%}
              {% case block.type %}
                {%- when 'heading' -%}
                  <h2
                    class="heading-enhanced image-with-text__heading inline-richtext {{ block.settings.heading_size }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.heading }}
                  </h2>
                {%- when 'caption' -%}
                  <p
                    class="image-with-text__text image-with-text__text--caption {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }} {{ block.settings.text_style }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.caption | escape }}
                  </p>
                {%- when 'text' -%}
                  <div class="image-with-text__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </div>
                {%- when 'button' -%}
                  {%- if block.settings.button_label != blank -%}
                    <a
                      {% if block.settings.button_link == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.button_link }}"
                      {% endif %}
                      class="button-enhanced button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}{% if block.settings.button_animation != 'none' %} button--{{ block.settings.button_animation }}{% endif %}"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.button_label | escape }}
                    </a>
                  {%- endif -%}

                {%- when 'stats' -%}
                  <div class="stats-counter" {{ block.shopify_attributes }}>
                    <div class="stat-item">
                      <span class="stat-number">{{ block.settings.stat_1_number }}</span>
                      <span class="stat-label">{{ block.settings.stat_1_label }}</span>
                    </div>
                    <div class="stat-item">
                      <span class="stat-number">{{ block.settings.stat_2_number }}</span>
                      <span class="stat-label">{{ block.settings.stat_2_label }}</span>
                    </div>
                    <div class="stat-item">
                      <span class="stat-number">{{ block.settings.stat_3_number }}</span>
                      <span class="stat-label">{{ block.settings.stat_3_label }}</span>
                    </div>
                  </div>
                {%- when 'feature_icon' -%}
                  <div class="feature-icon" {{ block.shopify_attributes }}>
                    {{ block.settings.icon }}
                  </div>
                  <span>{{ block.settings.feature_text }}</span>
                {%- when 'testimonial' -%}
                  <div class="testimonial-card" {{ block.shopify_attributes }}>
                    {%- if block.settings.rating > 0 -%}
                      <div class="star-rating">
                        {%- for i in (1..5) -%}
                          {%- if i <= block.settings.rating -%}
                            <span class="star filled">★</span>
                          {%- else -%}
                            <span class="star empty">★</span>
                          {%- endif -%}
                        {%- endfor -%}
                        <span class="rating-text">{{ block.settings.rating }}/5</span>
                      </div>
                    {%- endif -%}
                    <p>{{ block.settings.testimonial_text }}</p>
                    <div style="margin-top: 1rem; font-weight: 600; color: #2563EB;">
                      - {{ block.settings.testimonial_author }}
                    </div>
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

