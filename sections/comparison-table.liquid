            },
            {
              "value": "scheme-3",
              "label": "Scheme 3"
            },
            {
              "value": "scheme-4",
              "label": "Scheme 4"
            },
            {
              "value": "scheme-5",
              "label": "Scheme 5"
            },
            {
              "value": "background-1",
              "label": "Background 1"
            },
            {
              "value": "background-2",
              "label": "Background 2"
            },
            {
              "value": "accent-1",
