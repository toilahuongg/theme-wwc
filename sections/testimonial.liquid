{{ 'component-testimonial.css' | asset_url | stylesheet_tag }}

<div
  class="testimonial color-{{ section.settings.color_scheme }} gradient{% unless section.settings.background_style == 'none' and settings.text_boxes_border_thickness > 0 or settings.text_boxes_shadow_opacity > 0 %} background-{{ section.settings.background_style }}{% endunless %}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width section-{{ section.id }}-padding section-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="testimonial__container">
      {%- if section.settings.heading != blank -%}
        <div class="testimonial__header testimonial__header--{{ section.settings.heading_alignment | default: 'center' }}">
          <h2 class="heading testimonial__heading testimonial__heading--{{ section.settings.section_heading_size | default: 'h1' }}">
            {{ section.settings.heading | escape }}
          </h2>
          {%- if section.settings.subheading != blank -%}
            <div class="testimonial__subheading rte">
              <p>{{ section.settings.subheading | escape }}</p>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div
        class="testimonial__grid testimonial__grid--{{ section.settings.columns_desktop }}-columns"
        style="--grid-gap: {{ section.settings.grid_gap }}rem;"
      >
        {%- for block in section.blocks -%}
          <div
            class="testimonial-block testimonial-block--{{ block.settings.style }}{% if section.settings.show_box_shadow %} testimonial-block--shadow{% endif %} color-{{ section.settings.block_color_scheme }}"
            data-heading-size="{{ section.settings.heading_size | default: 'medium' }}"
            data-text-size="{{ section.settings.text_size | default: 'medium' }}"
            data-show-shadow="{{ section.settings.show_box_shadow }}"
            data-color-scheme="{{ section.settings.block_color_scheme }}"
            {{ block.shopify_attributes }}
          >
            <div class="testimonial-block__content">
              {%- if block.settings.quote != blank -%}
                <div class="testimonial-block__quote">
                  <svg
                    class="testimonial-block__quote-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" fill="currentColor"/>
                  </svg>
                  <div class="testimonial-block__text testimonial-block__text--{{ section.settings.text_size | default: 'medium' }} rte">
                    {{ block.settings.quote }}
                  </div>
                </div>
              {%- endif -%}

              <div class="testimonial-block__author">
                {%- if block.settings.author_image != blank -%}
                  <div class="testimonial-block__author-image">
                    {{
                      block.settings.author_image
                      | image_url: width: 80
                      | image_tag: loading: 'lazy', alt: block.settings.author_name
                    }}
                  </div>
                {%- endif -%}

                <div class="testimonial-block__author-info">
                  {%- if block.settings.author_name != blank -%}
                    <h4 class="testimonial-block__author-name testimonial-block__author-name--{{ section.settings.heading_size | default: 'medium' }}">
                      {{ block.settings.author_name | escape }}
                    </h4>
                  {%- endif -%}

                  {%- if block.settings.author_title != blank -%}
                    <p class="testimonial-block__author-title">
                      {{ block.settings.author_title | escape }}
                    </p>
                  {%- endif -%}

                  {%- if block.settings.rating != blank and block.settings.rating != '0' -%}
                    <div class="testimonial-block__rating">
                      {%- assign rating = block.settings.rating | plus: 0 -%}
                      {%- for i in (1..5) -%}
                        <span class="testimonial-block__star{% if i <= rating %} testimonial-block__star--filled{% endif %}">
                          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </span>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size == 0 -%}
        <div class="testimonial__placeholder">
          <div class="testimonial-block">
            <div class="testimonial-block__content">
              <div class="testimonial-block__quote">
                <svg
                  class="testimonial-block__quote-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" fill="currentColor"/>
                </svg>
                <div class="testimonial-block__text">
                  <p>Add your first testimonial block to showcase customer reviews and feedback.</p>
                </div>
              </div>
              <div class="testimonial-block__author">
                <div class="testimonial-block__author-info">
                  <h4 class="testimonial-block__author-name">Customer Name</h4>
                  <p class="testimonial-block__author-title">Customer Title</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Testimonial",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "select",
      "id": "section_heading_size",
      "options": [
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h3",
          "label": "Small"
        }
      ],
      "default": "h1",
      "label": "Section heading size"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real feedback from satisfied customers about our products and services"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Heading alignment"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Number of columns on desktop"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 1,
      "max": 6,
      "step": 0.5,
      "unit": "rem",
      "default": 2,
      "label": "Grid gap"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    },
    {
      "type": "select",
      "id": "background_style",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "primary",
          "label": "Primary"
        }
      ],
      "default": "primary",
      "label": "Background style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Block styling"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "xs",
          "label": "Extra Small"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra Large"
        },
        {
          "value": "2xl",
          "label": "2X Large"
        },
        {
          "value": "3xl",
          "label": "3X Large"
        }
      ],
      "default": "medium",
      "label": "Author name size"
    },
    {
      "type": "select",
      "id": "text_size",
      "options": [
        {
          "value": "xs",
          "label": "Extra Small"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra Large"
        },
        {
          "value": "2xl",
          "label": "2X Large"
        }
      ],
      "default": "medium",
      "label": "Quote text size"
    },
    {
      "type": "checkbox",
      "id": "show_box_shadow",
      "default": true,
      "label": "Show box shadow on blocks"
    },
    {
      "type": "color_scheme",
      "id": "block_color_scheme",
      "label": "Block color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote",
          "default": "<p>This product has completely transformed my experience. I couldn't be happier with the quality and service!</p>"
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Author image"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author name",
          "default": "John Doe"
        },
        {
          "type": "text",
          "id": "author_title",
          "label": "Author title/company",
          "default": "CEO, Company Name"
        },
        {
          "type": "select",
          "id": "rating",
          "options": [
            {
              "value": "0",
              "label": "No rating"
            },
            {
              "value": "1",
              "label": "1 star"
            },
            {
              "value": "2",
              "label": "2 stars"
            },
            {
              "value": "3",
              "label": "3 stars"
            },
            {
              "value": "4",
              "label": "4 stars"
            },
            {
              "value": "5",
              "label": "5 stars"
            }
          ],
          "default": "5",
          "label": "Rating"
        },
        {
          "type": "select",
          "id": "style",
          "options": [
            {
              "value": "default",
              "label": "Default"
            },
            {
              "value": "minimal",
              "label": "Minimal"
            },
            {
              "value": "card",
              "label": "Card"
            }
          ],
          "default": "default",
          "label": "Style"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonial",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "<p>Amazing product quality and excellent customer service. Highly recommended!</p>",
            "author_name": "Sarah Johnson",
            "author_title": "Marketing Director"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "<p>The best purchase I've made this year. Exceeded all my expectations!</p>",
            "author_name": "Mike Chen",
            "author_title": "Product Manager"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "<p>Outstanding quality and fast delivery. Will definitely buy again!</p>",
            "author_name": "Emily Davis",
            "author_title": "Business Owner"
          }
        }
      ]
    }
  ]
}
{% endschema %}
